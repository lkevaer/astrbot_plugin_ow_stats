{
  "api_url": {
    "description": "战绩服务地址",
    "type": "string",
    "default": "https://lkevaer.xyz",
    "hint": "填写可访问的现有 ow_stats_query 服务地址；默认复用 HTTPS 站点，容器内也可配置同网络的战绩服务地址。"
  },
  "api_key": {
    "description": "战绩服务访问码",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "填写战绩服务的 OW_SERVER_API_KEY。QQ AppSecret 仍在平台配置中管理。"
  },
  "default_mode": {
    "description": "默认查询模式",
    "type": "string",
    "default": "competitive",
    "options": ["competitive", "leisure"]
  },
  "timeout_seconds": {
    "description": "单批查询最长等待秒数",
    "type": "int",
    "default": 300
  }
}
